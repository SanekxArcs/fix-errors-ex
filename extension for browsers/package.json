{
  "name": "fix-errors-ai-extension",
  "version": "2.0.13",
  "private": true,
  "description": "A polished browser writing assistant powered by your own AI provider.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "prebuild": "node scripts/sync-public.mjs",
    "prebuild:firefox": "node scripts/sync-public.mjs",
    "prezip": "node scripts/sync-public.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "test": "node scripts/test-replacement.mjs",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "test:env": "node test/mock-server.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "wxt": "^0.20.6"
  }
}
