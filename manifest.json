{
  "manifest_version": 3,
  "name": "Fix Errors AI",
  "version": "1.1.0",
  "description": "Fixes grammar and translates selected text using Gemini AI.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/Logo-Luigis-Box-16.png",
      "48": "icons/Logo-Luigis-Box-48.png",
      "128": "icons/Logo-Luigis-Box-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "fix_grammar": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Fix typos and grammar of selected text"
    }
  },
  "icons": {
    "16": "icons/Logo-Luigis-Box-16.png",
    "48": "icons/Logo-Luigis-Box-48.png",
    "128": "icons/Logo-Luigis-Box-128.png"
  }
}
